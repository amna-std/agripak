# AgriPak — environment variables
# Copy to .env.local for local development. On Vercel, set these in
# Project Settings → Environment Variables. NEVER commit real values.

# --- Required ---

# MongoDB Atlas connection string (free M0 tier is enough).
# Atlas → Network Access → allow 0.0.0.0/0 so Vercel functions can connect.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/agripak

# Secret used to sign JWTs. Generate with: openssl rand -base64 48
JWT_SECRET=

# Google Gemini API key — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Gemini model id. Keep this value: pinned aliases such as gemini-2.0-flash can
# return HTTP 429 "limit: 0" on free-tier accounts, while the rolling alias works.
# The same model powers the scheme refresh below, using Google Search grounding.
GEMINI_MODEL=gemini-flash-latest

# --- Recommended ---

# Shared secret for the scheduled refresh endpoints (/api/market/refresh and
# /api/schemes/refresh). Without it those routes are reachable only by Vercel's
# own cron (which sends an `x-vercel-cron` header external callers cannot forge)
# or by a signed-in admin — so leaving it blank is safe, just less convenient
# for triggering a run by hand.
#
# Generate with: openssl rand -hex 32
# Call with:     curl -X POST https://<host>/api/schemes/refresh \
#                     -H "Authorization: Bearer $CRON_SECRET"
CRON_SECRET=

# --- Not required ---
# Weather comes from Open-Meteo, which needs no API key.
# Mandi prices come from AMIS Punjab (amis.pk), which needs no API key.
