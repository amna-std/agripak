{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "regions": ["bom1"],
  "crons": [
    {
      "path": "/api/market/refresh",
      "schedule": "0 */6 * * *"
    },
    {
      "path": "/api/schemes/refresh",
      "schedule": "20 3 * * *"
    }
  ],
  "functions": {
    "app/api/ai/**/route.ts": {
      "maxDuration": 60
    },
    "app/api/market/refresh/route.ts": {
      "maxDuration": 60
    },
    "app/api/schemes/refresh/route.ts": {
      "maxDuration": 60
    }
  }
}
